{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/embed.js",
      "destination": "/api/handler?__path=/embed.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/handler?__path=/api/$1"
    },
    {
      "source": "/((?!api/|embed\\.js|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
